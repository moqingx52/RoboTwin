{
  "schema_version": 2,
  "status": "template_not_frozen",
  "tasks": [
    "place_container_plate",
    "dump_bin_bigbin"
  ],
  "base_checkpoint_pattern": "policy/DP/checkpoints/{task}-demo_clean-200-0/600.ckpt",
  "rollouts_per_env_seed": 8,
  "rollout_dir": "experiments/brace/rollouts_traced",
  "pilot_rollout_dir": "experiments/brace/rollouts_traced_pilot",
  "task_config": "demo_brace_trace",
  "replay_audit": {
    "mode": "snapshot_control_trace",
    "trajectories_per_task": 20,
    "snapshots_per_trajectory": 3,
    "snapshot_rule": "interior_quartiles_on_physics_step",
    "continuation_horizon_physics_steps": "FREEZE_BEFORE_RUN",
    "restore_repeat_count": 3,
    "selection_seed": 0,
    "require_success_and_failure": true,
    "outcome_sampling": "near_balanced_without_replacement"
  },
  "actor_metrics": {
    "dump_bin_bigbin": {
      "deskbin": ["translation", "rotation"],
      "garbage_*": ["translation"]
    },
    "place_container_plate": {
      "container": ["translation", "rotation"]
    }
  },
  "candidate_points_per_pair": 4,
  "control_chunks_k": 3,
  "continuation_seeds_m": 3,
  "acceptance": {
    "one_sided_alpha": 0.1,
    "minimum_advantage_delta": 0.15
  },
  "replay_gate": {
    "minimum_pass_rate": 0.95,
    "restore_determinism_pass_rate": 1.0,
    "control_trace_replay_minimum_pass_rate": 0.95,
    "per_task_control_trace_replay_minimum_pass_rate": 0.95,
    "joint_max_error": "FREEZE_BEFORE_RUN",
    "end_effector_translation_error": "FREEZE_BEFORE_RUN",
    "end_effector_rotation_error": "FREEZE_BEFORE_RUN",
    "object_translation_error": "FREEZE_BEFORE_RUN",
    "object_rotation_error": "FREEZE_BEFORE_RUN"
  },
  "promotion": {
    "id_fraction_of_base": 0.8,
    "train_fraction_of_base": 0.75
  },
  "required_full_methods": [
    "base",
    "U1",
    "U4",
    "B1",
    "B2",
    "B3"
  ],
  "budget_axes": [
    "environment_transitions",
    "accepted_chunks",
    "optimizer_examples"
  ]
}
