{
  "schema_version": 2,
  "protocol_revision": "screen.v1.2",
  "status": "frozen",
  "frozen_on": "2026-08-03",
  "description": "BRACE developmental screen v1.2: separates sample_source from preservation_group, adds constraint feasibility gate, strict N1 matching, and staged micro-screens.",
  "changelog": [
    "Split episode_source (expert/rollout/prefix) from episode_preservation_group (base_solved/boundary/hard_monitor).",
    "Anchor replay set is independent from SFT chunk zarr; new chunks are not anchor imitation targets.",
    "Add constraint feasibility gate for B2/B3 checkpoint eligibility.",
    "Strengthen N1 negative control with env-seed and outcome matching.",
    "Add forgetting/newly-solved behavioral metrics; reserve split is never used for checkpoint selection.",
    "Anchor hyperparameters must not be tuned using Hard-20 results."
  ],
  "tasks": ["place_container_plate"],
  "base_checkpoint_pattern": "policy/DP/checkpoints/{task}-demo_clean-200-0/600.ckpt",
  "train_seed": 0,
  "screen_mode": "full",
  "active_methods": ["N1", "B1", "B2", "B3"],
  "screen_epochs": [1, 3, 5, 7, 10],
  "micro_screen_epochs": {
    "preservation_only": [1, 3, 5],
    "credit_only": [1, 3, 5, 7]
  },
  "training": {
    "learning_rate": 0.00005,
    "batch_size": 128,
    "rollout_per_batch": 16,
    "checkpoint_every": 1,
    "normalizer_source": "checkpoint",
    "teacher_reference": "raw",
    "anchor_samples_per_group": 8
  },
  "eval": {
    "id_seeds": 20,
    "train_seeds": 20,
    "hard_seeds": 20,
    "use_reserve_split": false,
    "hard_for_checkpoint_selection": false
  },
  "promotion": {
    "id_fraction_of_base": 0.8,
    "train_fraction_of_base": 0.75
  },
  "preservation_metrics": {
    "base_solved_forgetting_max_delta": 0.05,
    "require_b2_forgetting_below_u1": true
  },
  "credit_matching": {
    "match_env_seed": true,
    "match_trajectory_outcome": true,
    "match_chunk_index": true,
    "match_optimizer_budget": true,
    "max_chunk_share_per_seed": 0.25,
    "emit_matching_audit": true
  },
  "anchor_smoke": {
    "gate_level": "training_path",
    "identity_epsilon": 0.0001,
    "violation_steps": 50,
    "dual_lr": 0.01,
    "dual_nonnegativity": true,
    "teacher_no_grad": true,
    "shared_noise_timestep": true,
    "raw_ema_reference_fixed": true,
    "teacher_hash_stable_on_resume": true,
    "training_path": {
      "run_label": "place_pilot_v2.3",
      "dataset": "N1",
      "optimizer_steps": 1,
      "violation_steps": 10
    }
  },
  "constraint_feasibility": {
    "enabled": true,
    "mean_tolerance_factor": 2.0,
    "p90_max_factor": 5.0,
    "violation_fraction_max": {
      "base_solved": 0.5,
      "boundary": 0.5
    },
    "require_raw_and_ema": true,
    "diagnostic_steps": 200,
    "ineligible_if_infeasible": true
  },
  "branch_confirm_gate": {
    "min_seeds": 10,
    "min_points": 30,
    "max_seed_accepted_share": 0.2,
    "minimum_advantage_delta": 0.15,
    "one_sided_alpha": 0.1
  },
  "screens": {
    "credit": {
      "methods": ["base", "U1", "N1", "B1"],
      "requires_b1_beats_n1": true,
      "min_score_margin": 0.01
    },
    "preservation": {
      "methods": ["U1", "B2"],
      "requires_b2_beats_u1": true,
      "requires_constraint_feasibility": true,
      "requires_forgetting_gate": true
    },
    "integration": {
      "methods": ["B1", "B2", "B3"],
      "requires_prior_screens": true
    }
  },
  "gates": {
    "block_full_until_v12_developmental_pass": true,
    "block_dump_screen_until_place_pass": true,
    "do_not_tune_anchor_on_hard": true
  }
}
